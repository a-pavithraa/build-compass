{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && [ -f \"${CLAUDE_PLUGIN_ROOT}/map/status.mjs\" ] && { node \"${CLAUDE_PLUGIN_ROOT}/map/refresh.mjs\" --quiet; node \"${CLAUDE_PLUGIN_ROOT}/map/status.mjs\" --session-start; } || true",
            "timeout": 10,
            "statusMessage": "Checking the project map"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && [ -f \"${CLAUDE_PLUGIN_ROOT}/map/refresh.mjs\" ] && node \"${CLAUDE_PLUGIN_ROOT}/map/refresh.mjs\" --hook || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
